# --- Required ---
# Postgres connection string (any hosted Postgres works: Neon, Supabase DB, Railway, Render...)
DATABASE_URL=postgres://copywrite:copywrite@localhost:5432/copywrite

# Secret for signing session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# --- First-time setup ---
# Required in production to create the first account (the workspace owner). Others join via invite codes.
SETUP_TOKEN=

# --- AI (optional, but needed for every AI feature) ---
# Server-side only. Never exposed to the browser. Usage is billed separately by OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Optional OpenAI-compatible gateway URL. Leave empty to use api.openai.com
OPENAI_BASE_URL=

# --- Files ---
# Directory for uploaded files. On a hosted server this must be a persistent volume.
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=500

# --- Backups ---
# Nightly database backup archives (keep on the persistent disk in production)
BACKUP_DIR=./data/backups
BACKUP_ENABLED=true
BACKUP_KEEP=14

# --- Server ---
PORT=3000
# Public URL, used to validate the Origin header of websocket/API requests (e.g. https://copy.example.com)
PUBLIC_URL=http://localhost:5173
NODE_ENV=development
