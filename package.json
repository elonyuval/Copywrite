{
  "name": "copywrite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild server/restore.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/restore.js",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env server/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "restore": "tsx --env-file-if-exists=.env server/restore.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "build:demo": "vite build -c vite.demo.config.ts && node scripts/fix-demo-bundle.mjs"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@hocuspocus/provider": "^4.7.1",
    "@hocuspocus/server": "^4.7.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-collaboration": "^3.32.0",
    "@tiptap/extension-collaboration-caret": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/y-tiptap": "^3.0.10",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "openai": "^7.39.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tar": "^7.5.22",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
